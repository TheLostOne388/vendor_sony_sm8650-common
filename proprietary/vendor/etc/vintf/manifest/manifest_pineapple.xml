<!--
    Input:
        device/qcom/pineapple/manifest_pineapple.xml
        device/somc/asahi/manifest.xml
        device/somc/asahi/config/charger/vendor.semc.hardware.charger.manifest.xml
        device/somc/asahi/config/mmwave/vendor.semc.hardware.mmwavedirection.manifest.xml
        device/somc/asahi/config/wlan/vendor.somc.hardware.wifi.idd.manifest.xml
        device/somc/asahi/config/wlan/vendor.somc.hardware.aidlwifidriver.manifest.xml
-->
<manifest version="7.0" type="device" target-level="8">
    <!-- Audio HALs -->
    <hal format="hidl">
        <name>android.hardware.audio</name>
        <transport>hwbinder</transport>
        <fqname>@7.1::IDevicesFactory/default</fqname>
    </hal>
    <hal format="hidl">
        <name>android.hardware.audio.effect</name>
        <transport>hwbinder</transport>
        <fqname>@7.0::IEffectsFactory/default</fqname>
    </hal>

    <!-- Bluetooth HAL -->
    <hal format="hidl">
        <name>android.hardware.bluetooth</name>
        <transport>hwbinder</transport>
        <fqname>@1.1::IBluetoothHci/default</fqname>
    </hal>

    <!-- Updated AIDL HALs -->
    <hal format="aidl">
        <name>android.hardware.gatekeeper</name>
        <interface>
            <name>IGatekeeper</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl">
        <name>android.hardware.nfc</name>
        <interface>
            <name>INfc</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl">
        <name>android.hardware.secure_element</name>
        <interface>
            <name>ISecureElement</name>
            <instance>eSE1</instance>
            <instance>SIM1</instance>
            <instance>SIM2</instance>
        </interface>
    </hal>
    <!-- Add missing AIDL HALs from deprecated list -->
    <hal format="aidl">
        <name>android.hardware.camera.provider</name>
        <interface>
            <name>ICameraProvider</name>
            <instance>legacy/1</instance>
        </interface>
    </hal>

    <!-- Qualcomm HALs -->
    <hal format="hidl">
        <name>com.qualcomm.qti.dpm.api</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IdpmQmi/dpmQmiService</fqname>
    </hal>
    <hal format="hidl">
        <name>com.qualcomm.qti.imscmservice</name>
        <transport>hwbinder</transport>
        <fqname>@2.2::IImsCmService/qti.ims.connectionmanagerservice</fqname>
    </hal>
    <hal format="hidl">
        <name>com.qualcomm.qti.uceservice</name>
        <transport>hwbinder</transport>
        <fqname>@2.3::IUceService/com.qualcomm.qti.uceservice</fqname>
    </hal>

    <!-- Vendor-Specific AIDL HALs -->
    <hal format="aidl">
        <name>vendor.nxp.nxpnfc_aidl</name>
        <fqname>INxpNfc/default</fqname>
    </hal>
    <!-- Comment out incorrect vendor FingerprintRbs declaration -->
    <!--
    <hal format="aidl">
        <name>vendor.hardware.biometrics.fingerprintRbs</name>
        <fqname>IFingerprintRbs/Rbs</fqname>
    </hal>
    -->
    <hal format="aidl">
        <name>vendor.qti.hardware.spu</name>
    </hal>
    <hal format="aidl">
        <name>vendor.semc.hardware.spc</name>
        <fqname>ISpc/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.somc.hardware.aidlifaa</name>
        <fqname>IIFAAManagerService/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.somc.hardware.aidlwifidriver</name>
        <fqname>ISomcWifiDriver/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.somc.hardware.security.aidlsecd</name>
        <fqname>IDeviceSecurity/default</fqname>
    </hal>
    <hal format="aidl">
        <name>vendor.somc.hardware.wifi.idd</name>
        <fqname>ISomcWifiIdd/default</fqname>
    </hal>

    <!-- Vendor-Specific HIDL HALs -->
    <hal format="hidl">
        <name>vendor.qti.hardware.bluetooth_audio</name>
        <transport>hwbinder</transport>
        <fqname>@2.1::IBluetoothAudioProvidersFactory/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.bluetooth_sar</name>
        <transport>hwbinder</transport>
        <fqname>@1.1::IBluetoothSar/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.btconfigstore</name>
        <transport>hwbinder</transport>
        <fqname>@2.0::IBTConfigStore/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.cacert</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IService/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.capabilityconfigstore</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ICapabilityConfigStore/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.dsp</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IDspService/dspservice</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.factory</name>
        <transport>hwbinder</transport>
        <fqname>@1.1::IFactory/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.fm</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IFmHci/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.hardware.secureprocessor.device</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::ISecureProcessor/qti-tee</fqname>
        <fqname>@1.0::ISecureProcessor/qti-tvm</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.ims.callinfo</name>
        <transport>hwbinder</transport>
        <fqname>@1.0::IService/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.ims.factory</name>
        <transport>hwbinder</transport>
        <fqname>@1.1::IImsFactory/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.qti.spu</name>
        <transport>hwbinder</transport>
        <fqname>@1.1::ISPUManager/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.semc.hardware.charger</name>
        <transport>hwbinder</transport>
        <fqname>@1.2::ICharger/default</fqname>
    </hal>
    <hal format="hidl">
        <name>vendor.semc.hardware.mmwavedirection</name>
        <transport>hwbinder</transport>
        <fqname>@1.1::IMmwavedirection/default</fqname>
    </hal>

    <!-- SEPolicy -->
    <sepolicy>
        <version>34.0</version>
    </sepolicy>
</manifest>